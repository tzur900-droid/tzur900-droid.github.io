{
  "manifest_version": 3,
  "name": "נגן צנוע - סינון סרטים",
  "version": "1.0.0",
  "description": "מנגן סרטים מהדרייב או מהמחשב עם כיסוי לבוש לא צנוע ודילוג על קטעים לא צנועים. הכל רץ במחשב, בלי אינטרנט ובלי עלות.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "פתח את הנגן הצנוע" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "host_permissions": [
    "https://drive.google.com/*",
    "https://drive.usercontent.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "content_scripts": [
    { "matches": ["https://drive.google.com/*"], "js": ["drive.js"], "run_at": "document_idle" }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
